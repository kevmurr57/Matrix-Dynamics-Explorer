{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "python manage.py migrate --noinput && gunicorn mde.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 120"
  }
}
