# Copy to .env for local development, or set these in your host's dashboard.
# Never commit the real .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Leave False in production. When True, an ephemeral key is generated if
# DJANGO_SECRET_KEY is unset.
DJANGO_DEBUG=False

# Comma-separated hostnames this app may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated origins trusted for CSRF; scheme required.
# e.g. https://your-app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set True only if your host does not already redirect HTTP to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
